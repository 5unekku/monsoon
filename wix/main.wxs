<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 3 installer source for monsoon.
  Build in CI via:
    heat dir installer -o wix\dlls.wxs -cg DllFiles -dr INSTALLFOLDER ...
    candle -arch x64 -dProductVersion=<x.y.z> -dInstallerDir=installer wix\main.wxs wix\dlls.wxs
    light wix\main.wixobj wix\dlls.wixobj -ext WixUIExtension -o monsoon-<tag>-x86_64-windows.msi
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="monsoon"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="5unekku"
           UpgradeCode="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">

    <Package InstallerVersion="450"
             Compressed="yes"
             InstallScope="perUser"
             Description="monsoon torrent client" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of monsoon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <UIRef Id="WixUI_Minimal" />

    <Feature Id="Complete" Level="1">
      <ComponentGroupRef Id="BinaryFiles" />
      <ComponentGroupRef Id="DllFiles" />
    </Feature>

  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="monsoon" />
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="BinaryFiles" Directory="INSTALLFOLDER">
      <Component Id="MainBinary">
        <File Id="monsoon.exe"
              Source="$(var.InstallerDir)\monsoon.exe"
              KeyPath="yes" />
        <Environment Id="UserPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="no" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
